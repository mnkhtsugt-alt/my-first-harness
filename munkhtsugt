#include <stdio.h>

int factorial(int n) {
    if (n < 0) {
        return -1;
    }

    int result = 1;

    for (int i = 1; i <= n; i++) {
        result *= i;
    }

    return result;
}

int main(void) {
    int n;

    printf("Enter a number: ");

    if (scanf("%d", &n) != 1) {
        printf("Invalid input\n");
        return 1;
    }

    int result = factorial(n);

    if (result == -1) {
        printf("Negative numbers are not allowed.\n");
    } else {
        printf("%d! = %d\n", n, result);
    }

    return 0;
}
